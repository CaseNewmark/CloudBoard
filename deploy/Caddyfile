# One domain for everything: the app at /, the API at /api and /hubs, Keycloak at /keycloak.
# (Not /auth: the app's own OAuth callback route is /auth/callback.)
# Caddy gets and renews the HTTPS certificate automatically for the host in PUBLIC_URL.
{$PUBLIC_URL} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	# Keycloak listens at / inside the network; KC_HOSTNAME tells it its public URL is /keycloak.
	redir /keycloak /keycloak/
	handle_path /keycloak/* {
		reverse_proxy keycloak:8080
	}

	handle {
		root * /srv
		# Client-side routes (e.g. /cloudboard/<id>) all load index.html.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

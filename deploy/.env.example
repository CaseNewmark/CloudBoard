# Copy to .env and fill in. Never commit .env.

# The public address of the app, without a trailing slash. Caddy requests an HTTPS
# certificate for this host, so its DNS record must point at this server.
PUBLIC_URL=https://cloudboard.example.com

# Postgres password (used by the API and Keycloak). Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Password for the Keycloak "admin" account (admin console at $PUBLIC_URL/keycloak/admin).
KEYCLOAK_ADMIN_PASSWORD=

# Google OAuth client (type "Web application") that Keycloak uses for "Sign in with Google".
# Authorized redirect URI in the Google Cloud Console: $PUBLIC_URL/keycloak/realms/cloudboard/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free AutoMapper Community license key from https://automapper.io (optional; without it AutoMapper logs a warning).
AUTOMAPPER_LICENSE_KEY=
